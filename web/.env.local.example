# ============================================================================
# Jobnest — environment variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and anon key — Supabase dashboard › Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key — server-side only (admin ops: OTP, account deletion, crons)
# WARNING: Never expose this to the browser / client bundle.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── App URLs ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL  — SEO metadata (OG tags, sitemap, canonical URLs)
# NEXT_PUBLIC_APP_URL   — transactional emails (sign-in links, deletion notices)
# Keep both identical in production. Separate vars allow the marketing URL to
# change without breaking email deep-links.
NEXT_PUBLIC_SITE_URL=https://jobnest.nishpatel.dev
NEXT_PUBLIC_APP_URL=https://jobnest.nishpatel.dev

# ── Security ──────────────────────────────────────────────────────────────────
# CSRF token signing secret — REQUIRED in production.
# Generate: openssl rand -hex 32
CSRF_SECRET=replace-with-a-64-char-random-hex-string

# Cron job bearer token — protects all /api/cron/* endpoints.
# Vercel automatically injects this as Authorization: Bearer <CRON_SECRET>.
# Generate: openssl rand -hex 32
CRON_SECRET=replace-with-a-64-char-random-hex-string

# Email (AWS SES)
# Used for all account emails, reminders, digests, contact, and feedback.
# Verify SES_FROM_EMAIL in this region before sending.
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=your_ses_access_key_id
AWS_SES_SECRET_ACCESS_KEY=your_ses_secret_access_key
SES_FROM_EMAIL=me@nishpatel.dev
CONTACT_EMAIL=me@nishpatel.dev
# Optional: temporary credentials and SES event tracking
# AWS_SES_SESSION_TOKEN=
# AWS_SES_CONFIGURATION_SET=
# Standard AWS_* credentials or an IAM role are also supported.

# ── AI — NESTAi + ATS Scanner ────────────────────────────────────────────────
# At least one provider is required for NESTAi and the ATS Scanner to work.
# The ATS Scanner UI shows only the providers whose keys are configured here.

# Groq — free tier, fastest. Used by NESTAi and the default ATS provider.
# Get key: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key

# OpenAI — GPT-4o mini used for ATS scanning AND NESTAi RAG (Pro).
# RAG uses text-embedding-3-small (~$0.02 / 1M tokens) to build pgvector
# embeddings of each user's applications, contacts, and reminders so NESTAi
# can do semantic context retrieval instead of a full data dump.
# Prerequisite: enable the pgvector extension in Supabase dashboard
#   (Database > Extensions > vector) and run migration 00047_nestai_rag.sql.
# RAG is silently skipped when this key is absent.
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key

# Anthropic — Claude Haiku 4.5 used for ATS scanning.
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# Google Gemini — Gemini 1.5 Flash used for ATS scanning.
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Perplexity — Sonar Small 128k used for ATS scanning.
# Get key: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-your_perplexity_api_key

# ── Security — Virus scanning (Cloudmersive) ──────────────────────────────────
# All document uploads and URL imports are scanned for malware before storage.
# Skipped gracefully when absent — magic-byte + MIME validation still runs.
# Free tier: 800 scans / month. Get key: https://api.cloudmersive.com
CLOUDMERSIVE_API_KEY=your_cloudmersive_api_key

# ── Stripe (billing) ──────────────────────────────────────────────────────────
# Use test keys (sk_test_...) in development, live keys (sk_live_...) in production.
# Get keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Webhook signing secret — generated when you register the endpoint in Stripe.
# Endpoint URL:  https://yourdomain.com/api/stripe/webhook
# Events to subscribe: checkout.session.completed, customer.subscription.updated,
#                      customer.subscription.deleted, invoice.payment_failed
# Local testing:  stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Stripe Price IDs — create products in Stripe dashboard › Products
STRIPE_PRO_PRICE_ID=price_your_pro_monthly_price_id

# Annual billing toggle (optional — leave blank to hide the toggle on /pricing)
STRIPE_PRO_ANNUAL_PRICE_ID=price_your_pro_annual_price_id

# ── GitHub OAuth (Developer Portfolio) ───────────────────────────────────────
# Create a GitHub OAuth App: https://github.com/settings/applications/new
#   Homepage URL:        https://yourdomain.com
#   Callback URL:        https://yourdomain.com/api/portfolio/github/callback
# Required for: GitHub profile card, repo sync, public portfolio
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# Optional: dedicated secret for OAuth state signing (defaults to CSRF_SECRET)
# GITHUB_STATE_SECRET=replace-with-another-64-char-random-hex

# ── Redis (Upstash) — optional but strongly recommended in production ──────────
# Persistent cross-instance rate limiting (in-memory fallback resets on cold starts).
# Create a free database: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ── Testing (Playwright E2E) ───────────────────────────────────────────────────
# Only needed when running E2E tests against a staging environment.
PLAYWRIGHT_BASE_URL=https://your-staging-url.vercel.app
E2E_TEST_EMAIL=your_test_account@example.com
E2E_TEST_PASSWORD=your_test_password

# ============================================================================
# Setup checklist
# ============================================================================
# 1. Supabase
#    [ ] Create project at https://supabase.com
#    [ ] Run all migrations in supabase/migrations/ (in numeric order)
#    [ ] Enable Email provider: Authentication > Providers
#    [ ] Enable Google / GitHub OAuth: Authentication > Providers
#    [ ] Set Site URL + redirect URLs: Authentication > URL Configuration
#
# 2. Required vars (app throws on startup if any of these are missing)
#    [ ] NEXT_PUBLIC_SUPABASE_URL
#    [ ] NEXT_PUBLIC_SUPABASE_ANON_KEY
#    [ ] SUPABASE_SERVICE_ROLE_KEY
#    [ ] CSRF_SECRET            (openssl rand -hex 32)
#    [ ] CRON_SECRET            (openssl rand -hex 32)
#    [ ] AWS_SES_REGION + AWS_SES_ACCESS_KEY_ID / AWS_SES_SECRET_ACCESS_KEY (or IAM role)
#    [ ] SES_FROM_EMAIL (verified in SES)
#    [ ] CONTACT_EMAIL
#    [ ] NEXT_PUBLIC_APP_URL
#
# 3. AI — set at minimum GROQ_API_KEY for NESTAi to work
#    Additional provider keys unlock extra options in the ATS Scanner.
#
# 4. Virus scanning — set CLOUDMERSIVE_API_KEY (800 free scans/month)
#    Uploads still work without it; only magic-byte validation runs.
#
# 5. Billing — set all three STRIPE_* vars AND run migration 00010_subscriptions.sql
#    The app degrades gracefully without them (Pro plan shows "Coming Soon").
#
# 6. Redis — set UPSTASH_* for reliable rate limiting across Vercel instances.
#    Without it the in-memory limiter resets on every cold start.
#
# 7. Cron jobs (vercel.json schedules these — Vercel injects CRON_SECRET automatically)
#    /api/cron/process-deletions    daily  09:00 UTC  — soft-delete grace period
#    /api/cron/overdue-reminders    daily  09:00 UTC  — overdue reminder emails + in-app
#    /api/cron/weekly-digest        Monday 08:00 UTC  — weekly digest emails
#    /api/cron/follow-up-reminders  daily  09:00 UTC  — Day 7/14/21 follow-up nudges
#    /api/cron/re-engagement        daily  10:00 UTC  — 14-day inactivity emails
#    /api/cron/github-sync          daily  04:00 UTC  — refresh GitHub profile + repos
#
# 8. Portfolio (optional)
#    [ ] Create GitHub OAuth App at https://github.com/settings/applications/new
#        Callback URL: https://yourdomain.com/api/portfolio/github/callback
#    [ ] Set GITHUB_CLIENT_ID + GITHUB_CLIENT_SECRET
#    [ ] Run web/sql/portfolio.sql in Supabase SQL Editor
# ============================================================================
